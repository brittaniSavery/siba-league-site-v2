---
import ProRules from "@components/rules/pro/ProRules.mdx";
import RulesIntro from "@components/rules/RulesIntro.mdx";
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import { PRO_LEAGUE_INFO } from "@lib/constants";
import { getProTeams } from "@lib/utils";

const title = "SIBA (Pro) Rules";

const proInfo = await getProTeams();
---

<MarkdownLayout content={{ title }}>
  <RulesIntro leagueInfo={PRO_LEAGUE_INFO} />
  <ProRules proInfo={proInfo} />
</MarkdownLayout>
