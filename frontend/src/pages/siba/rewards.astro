---
import { Content as RewardsIntro } from "@components/RewardsIntro.md";
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import { PRO_LEAGUE_INFO } from "@lib/constants";
import { getProTeams } from "@lib/utils";
import { format } from "date-fns";

const proInfo = await getProTeams();
const teams = proInfo.teams;
const lastUpdated = proInfo.lastUpdated;
---

<MarkdownLayout content={{ title: `${PRO_LEAGUE_INFO.abbv} Rewards` }}>
  <RewardsIntro />
  <h3>Current Team Reward Points</h3>
  <p><strong>Last Updated:</strong> {format(lastUpdated, "MMM d, yyyy")}</p>
  <table>
    <tr>
      <th>Team</th>
      <th>Points</th>
    </tr>
    {
      teams?.map((team) => (
        <tr>
          <td>{team.name}</td>
          <td>{team.points}</td>
        </tr>
      ))
    }
  </table>
</MarkdownLayout>
