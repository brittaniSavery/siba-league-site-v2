---
import DownloadFileTime from "@components/download/DownloadFileTime";
import HumanTeamFileTimes from "@components/download/HumanTeamFileTimes";
import BaseLayout from "@layouts/BaseLayout.astro";
import { GAME_YEAR_VERSION, LEAGUE } from "@lib/constants";
import { getProHumanTeams } from "@lib/utils";

const title = "Download SIBA (Pro) Program Files";

const humanTeams = await getProHumanTeams();
console.log(humanTeams);
---

<BaseLayout content={{ title }}>
  <section class="content">
    <h1 id={`downloads-pro`}>{title}</h1>
    <p>
      These files are required for running the pro league in Draft Day Sports:
      Pro Basketball {GAME_YEAR_VERSION} by Wolverine Studios. Please review the
      <a href="/siba/rules">rules</a> for more informaiton on the specific game version.
      If you need help, drop by our <a
        href="https://discord.com/invite/UqQh3zPBrV">Discord</a
      >.
    </p>
    <p>
      <ul>
        <li>
          <a href={`${import.meta.env.SITE}/files/pro/SIBA.zip`}>League File</a>
          - This file contains all the league information. It should be exported at
          <code
            >/Wolverine Studios/DDSPB{GAME_YEAR_VERSION}/app/disk/saves/</code
          > folder location.
          <br />
          <i
            >Last Modified: <DownloadFileTime
              league={LEAGUE.pro}
              file="main"
              client:idle
            />
          </i>
          <li>
            <a
              href={`${import.meta.env.SITE}/files/pro/DDSPB${GAME_YEAR_VERSION}.zip`}
              >Graphics File</a
            >
          </li> - This file contains all the graphics needed, including logos, players/coaches
          pictures, uniforms, etc. It should be exported at <code
            >/Wolverine Studios/</code
          >
          <br />
          <i
            >Last Modified: <DownloadFileTime
              league={LEAGUE.pro}
              file="graphics"
              client:idle
            />
          </i>
        </li>
      </ul>
    </p>
    <h2>Owners Exports</h2>
    <p>
      Current human owners can use this table to verify the dates of their
      latest exports.
    </p>
    <HumanTeamFileTimes league={LEAGUE.pro} teams={humanTeams} client:idle />
  </section>
</BaseLayout>
