---
import DownloadFileTime from "@components/DownloadPage/DownloadFileTime";
import HumanTeamFileTimes from "@components/DownloadPage/HumanTeamFileTimes";
import BaseLayout from "@layouts/BaseLayout.astro";
import { GAME_YEAR_VERSION, LEAGUE } from "@lib/constants";
import type {
  Member,
  HumanTeam,
  StrapiCollectionResponse,
  StrapiSingleTypeResponse,
  StrapiTeamInfo,
} from "@lib/types";
import { getDataFromApi, mergeArrays } from "@lib/utils";

const title = "Download SICBA (College) Program Files";

const strapiMembers = await getDataFromApi<StrapiCollectionResponse<Member>>(
  `${import.meta.env.PUBLIC_CMS_URL}/coaches?sort=team&pagination[limit]=100`
);
const members: HumanTeam[] = strapiMembers.data.map((m) => ({
  team: m.attributes.team,
  member: m.attributes.name,
}));
const teamInfo = await getDataFromApi<StrapiSingleTypeResponse<StrapiTeamInfo>>(
  `${import.meta.env.PUBLIC_CMS_URL}/college-info`
);
const teams: HumanTeam[] =
  teamInfo.data.attributes.teams.map((t) => ({
    id: t.id,
    team: `${t.name} ${t.mascot}`,
  })) || [];

const humanTeams = mergeArrays(members, teams, "team");
---

<BaseLayout content={{ title }}>
  <section class="content">
    <h1 id={`downloads-college`}>{title}</h1>
    <p>
      These files are required for running the college league in Draft Day
      Sports: College Basketball {GAME_YEAR_VERSION} by Wolverine Studios. Please
      review the
      <a href="/college/rules">rules</a> for more informaiton on the specific game
      version. If you need help, drop by our <a
        href="https://discord.com/invite/UqQh3zPBrV">Discord</a
      >.
    </p>
    <p>
      <ul>
        <li>
          <a href={`${import.meta.env.SITE}/files/college/SIBA.zip`}
            >League File</a
          >
          - This file contains all the league information. It should be exported
          at <code
            >/Wolverine Studios/DDSCB{GAME_YEAR_VERSION}/app/disk/saves/</code
          > folder location.
          <br />
          <i
            >Last Modified: <DownloadFileTime
              league={LEAGUE.college}
              file="main"
              client:idle
            />
          </i>
          <li>
            <a
              href={`${import.meta.env.SITE}/files/college/DDSCB${GAME_YEAR_VERSION}.zip`}
              >Graphics File</a
            > - This file contains all the graphics needed, including logos, players/coaches
            pictures, uniforms, etc. It should be exported at <code
              >/Wolverine Studios/</code
            >
            <br />
            <i
              >Last Modified: <DownloadFileTime
                league={LEAGUE.college}
                file="graphics"
                client:idle
              />
            </i>
          </li>
        </li>
      </ul>
    </p>
    <h2>Owners Exports</h2>
    <p>
      Current human owners can use this table to verify the dates of their
      latest exports.
    </p>
    <HumanTeamFileTimes
      league={LEAGUE.college}
      teams={humanTeams}
      client:idle
    />
  </section>
</BaseLayout>
