---
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Member, StrapiCollectionResponse } from "@lib/types";
import { getDataFromApi } from "@lib/utils";

const strapiMembers = await getDataFromApi<StrapiCollectionResponse<Member>>(
  `${import.meta.env.PUBLIC_CMS_URL}/coaches?sort=team&pagination[limit]=100`
);
const members = strapiMembers.data;
---

<BaseLayout content={{ title: "SICBA Head Coaches" }}>
  <section class="content"><h1>{"SICBA Head Coaches"}</h1></section>
  <div class="columns is-multiline">
    {
      members.map(({ attributes: { team, logo, name } }) => (
        <div class="column is-one-fifth-widescreen is-4-tablet has-text-centered">
          <img
            src={`${import.meta.env.SITE}/files/college/Website/images/${logo}`}
            alt={`${team} logo`}
          />
          <p class="title is-4">{team}</p>
          <p class="subtitle is-6">{name}</p>
        </div>
      ))
    }
  </div>
</BaseLayout>
