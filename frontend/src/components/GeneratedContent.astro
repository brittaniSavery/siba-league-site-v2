---
import BaseLayout from "@layouts/BaseLayout.astro";
import type { LEAGUE } from "@lib/constants";

export type Props = {
  title: string;
  league: LEAGUE | string;
  file: string;
};

const { title, league, file } = Astro.props as Props;
---

<BaseLayout fullWidth content={{ title }}>
  <section class="hero is-fullheight-with-navbar">
    <div class="hero-body">
      <iframe
        id="websitePage"
        title={title}
        src={`${import.meta.env.BASE_URL}files/${league}/Website/${file}.html`}
        style="height: 100vh; width: 100%; padding-bottom: 5rem;"></iframe>
    </div>
  </section>
</BaseLayout>
