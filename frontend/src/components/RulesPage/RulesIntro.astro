---
import {
  PRO_LEAGUE_INFO,
  COLLEGE_LEAGUE_INFO,
  LEAGUE,
  DISCORD_LINK,
  GAME_YEAR_VERSION,
} from "@lib/constants";

const { league } = Astro.props as { league: LEAGUE };
const leagueInfo =
  league === LEAGUE.pro ? PRO_LEAGUE_INFO : COLLEGE_LEAGUE_INFO;
---

<p>
  Thanks for checking our {leagueInfo.typeFull} basketball league. You will find
  the rules and other important information about the league below. If you have any
  questions, please reach out to us on <a href={DISCORD_LINK} target="_blank"
    >Discord</a
  >. And don't forget to <a href="/join">join</a>!
</p>

<h2>General Information</h2>
<ul>
  <li>
    <b>Program:</b> Draft Day Sports: {leagueInfo.typeAbbv} Basketball {
      GAME_YEAR_VERSION
    } powered by <a href="https://www.wolverinestudios.com/" target="_blank"
      >Wolverine Studios</a
    >
  </li>
  <li>
    <b>Export File Deadlines:</b>
    {leagueInfo.simDays} at 4:00 PM CENTRAL TIME
    <ul>
      <li>
        <strong>NOTE:</strong> After 4PM, there is no guarantee your changes will
        be included. Be sure to check when 4PM Central is in your timezone. This
        time <a
          href="https://www.timeanddate.com/worldclock/converter.html?iso=20221121T030000&p1=tz_ct"
          target="_blank">time zone converter</a
        >
        has been very reliable.
      </li>
    </ul>
  </li>
  <li>
    <b>How to Export Your File:</b>
    <ol>
      <li>Load the SICBA association from the main menu</li>
      <li>
        Complete all changes for team ({
          league === LEAGUE.college && "recruiting, "
        }updating depth chart and strategy, talking with players, etc.)
      </li>
      <li>
        Go to your office, located on the lefthand-side menu with the
        <span class="icon-text">
          <span class="icon">
            <i class="fa-solid fa-briefcase"></i>
          </span>
          <span>briefcase</span>
        </span> icon
      </li>
      <li>
        Click the {leagueInfo.color} "{
          league === LEAGUE.college && "Save & "
        }Export MP File" button at the bottom right-hand corner
      </li>
    </ol>
  </li>
  <li>
    <b>How to Download the League File In-Game:</b>
    <ol>
      <li>On the main menu, click the "Update Multiplayer League" option</li>
      <li>
        Select and open the SI{league === LEAGUE.college && "C"}BA.cbb file
      </li>
      <li>Wait until the sign-in page appears</li>
      <li>Sign-in</li>
    </ol>
  </li>
</ul>

<h2>Important Game Dates</h2>

<!-- Insert calendar component -->
